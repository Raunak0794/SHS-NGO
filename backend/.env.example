PORT=5000
NODE_ENV=production
# DATABASE ISOLATION:
# V1: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/shs-ngo (or shs_ai)
# V2: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/shs_ai_v2 (separate database)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/shs_ai_v2
JWT_SECRET=replace-with-a-strong-secret
FRONTEND_URL=https://shs-ai-v2.vercel.app
FRONTEND_URLS=http://localhost:5173,https://shs-ai-v2.vercel.app
BACKEND_URL=https://shs-ai-v2-api.onrender.com
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GROQ_MODEL=openai/gpt-oss-20b
AI_PROVIDER=gemini
AI_REQUEST_TIMEOUT_MS=20000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
REDIS_URL=redis://localhost:6379
TOKEN_CACHE_MS=30000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="SHS AI <no-reply@example.com>"
PASSWORD_RESET_TTL_MINUTES=30
UPLOAD_DIR=/tmp/shs-uploads
MAX_UPLOAD_SIZE_MB=200
